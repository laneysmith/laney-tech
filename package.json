{
  "name": "laney-tech",
  "private": true,
  "description": "Laney Pouzet's portfolio",
  "version": "1.0.0",
  "author": "Laney Pouzet <lsmith.unc@gmail.com>",
  "type": "module",
  "dependencies": {
    "global": "^4.4.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "styled-components": "^5.3.3",
    "typeface-pt-mono": "^1.1.13",
    "typography": "^0.16.24",
    "typography-theme-github": "^0.16.19"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.15.18",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@types/styled-components": "^5.1.34",
    "@types/typography": "^0.16.8",
    "@vitejs/plugin-react": "^4.4.1",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "husky": "^9.0.11",
    "jest-styled-components": "^7.2.0",
    "jsdom": "^26.1.0",
    "lint-staged": "^15.2.2",
    "prettier": "^3.2.5",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.30.1",
    "vite": "^6.3.5",
    "vite-plugin-svgr": "^4.0.0",
    "vitest": "^3.1.3"
  },
  "husky": {
    "hooks": {
      "pre-commit": "pnpm tsc && lint-staged",
      "pre-push": "pnpm test"
    }
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json}": [
      "prettier --write"
    ],
    "src/**/*.{js,jsx,ts,tsx}": [
      "eslint --fix"
    ]
  },
  "homepage": "https://laney.tech",
  "license": "MIT",
  "main": "n/a",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest --watch=false",
    "test:watch": "vitest",
    "postinstall": "husky"
  }
}
